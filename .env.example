# ===== MySQL =====
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_ROOT_NAME=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=why_choose_cs

# ===== AI（任意兼容 OpenAI /chat/completions 接口的第三方提供商）=====
# 必填：api key
AI_API_KEY=
# 必填：提供商的接口地址，不要写死，按你用的服务填
# 示例（DeepSeek 官方）：https://api.deepseek.com
AI_BASE_URL=
# 必填：模型名
# 示例（DeepSeek 官方）：deepseek-chat
AI_MODEL=

# ===== 可选配置 =====
# 打印 SQL 日志
# DB_ECHO=false

# 上传大小上限（MB）
# AVATAR_MAX_MB=2
# MD_MAX_MB=1
# HTML_MAX_MB=2

# 热度排序参数（一般不用改）
# HOT_OFFSET=2.0
# HOT_GRAVITY=1.8
# HOT_WINDOW_DAYS=30
